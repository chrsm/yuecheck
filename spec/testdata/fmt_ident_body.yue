-- input
base64_encode = (data) ->
  b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
  data\gsub('.', (x) ->
    r, b_val = '', x\byte!
    for i = 8, 1, -1
      r ..= (b_val % 2 ^ i - b_val % 2 ^ (i - 1) > 0) and '1' or '0'
    r
  )\gsub('%d%d%d?%d?%d?%d?', (x) ->
    if #x < 6
      return ''
    c = 0
    for i = 1, 6
      c += (x\sub(i, i) == '1' and 2 ^ (6 - i) or 0)
    b\sub(c + 1, c + 1)
  ) .. ({ '', '==', '=' })[#data % 3 + 1]

-- expect
base64_encode = (data) ->
  b = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'
  data\gsub('.', (x) ->
    r, b_val = '', x\byte!
    for i = 8, 1, -1
      r ..= (b_val % 2^i - b_val % 2^(i - 1) > 0) and '1' or '0'
    r
  )\gsub('%d%d%d?%d?%d?%d?', (x) ->
    if #x < 6
      return ''
    c = 0
    for i = 1, 6
      c += (x\sub(i, i) == '1' and 2^(6 - i) or 0)
    b\sub(c + 1, c + 1)
  ) .. ({ '', '==', '=' })[#data % 3 + 1]
