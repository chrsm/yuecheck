  @yue_name: 'AssignableNameList'

  -- @items: _list_t(true,NameOrDestructure)
  new: (items = {}) =>
    @items = items

  from_table: (tbl) =>
    for i, v in ipairs tbl
      if _in v\g_yue_name!, { 'NameOrDestructure' }
        table.insert @items, v
