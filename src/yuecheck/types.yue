    @value = value

  from_table: (tbl) =>
    for i, v in ipairs tbl
      if (not @arrow) and v\g_yue_name! == 'FnArrowBack'
        @arrow = v
        continue
      if (not @value) and v\g_yue_name! == 'ChainValue'
        @value = v
        continue
      _ = v
    nil

  walk: (visitor) =>
    @arrow\walk visitor if @arrow
    @value\walk visitor if @value
    visitor @
ast_nodes.SubBackcall = SubBackcall

