-- AST utilities for yuecheck
import 'yue'

import 'yuecheck.ast.assign' as assign
import 'yuecheck.ast.views' as views
import 'yuecheck.internal.xstring'
import 'yuecheck.types'

-- Build internal AST representation from yue.to_ast output
build = (ast, parent = nil) ->
  -- { type, begin_line, begin_col, end_line, end_col, children... }
  { ntype, ln, col, end_ln, end_col } = ast

  arg = {}
  if #ast > 5
    child = ast[6]
    switch true
      when (type child) == 'table'
        for v in *ast[6,]
          unless v
            break
          arg[] = build v, { ntype, ast }
      --[[ handle various AST simplifications from yue.to_ast ]]
      when ntype == 'Invoke'
        n = types.SingleString child
        n\set_source ln, col, end_ln, end_col
        arg[] = n
      when ntype == 'ReversedIndex' and child == '[#]'
        n = types.ReversedIndex!
        n\set_source ln, col, end_ln, end_col
        arg[] = n
      when ntype == 'VarArgDef' and child == '...'
        n = types.VarArgDef types.Variable types.Name '...'
        n\set_source ln, col, end_ln, end_col
        arg[] = n
      when ntype == 'TableLit' and string.sub(child, 1, 1) == '{'
        -- raw table literal string (e.g., "{\n\t-- comment\n}")
        raw = child
        if (xstring.count_nl raw) > 0
          arg._raw_content = raw
        else
          n = types.SingleString raw
          n\set_source ln, col, end_ln, end_col
          arg[] = n
      when ntype == 'FnArgDefList' and child == ''
        arg[] = types.FnArgDef types.Variable types.Name ''
      when ntype == 'DefaultValue' and child == ''
        arg[] = types.DefaultValue ''
      when ntype == 'DoubleString'
        arg[] = types.DoubleStringInner ''
          |> types.DoubleStringContent
          |> types.DoubleString
      --[[ nops ]]
      when ntype == 'Return' and child == 'return'
        _ = nil -- explicit return keyword, no value
      when ntype == 'Block' and child == ''
        _ = nil -- empty files; just comments
      when ntype == 'Comprehension' and child == '[]'
        _ = nil -- empty comprehension
      when ntype == 'OuterVarShadow' and child == 'using nil'
        _ = nil -- leave node empty; formatter writes 'using nil'
      when ntype == 'ClassDecl' and child == 'class'
        _ = nil -- `x = class` with nothing else
      else
        arg[] = child

  node = types[ntype]!
  node\from_table arg
  node\set_source ln, col, end_ln, end_col
  node.typ = ntype

  -- attach raw content metadata for TableLit nodes with multiline comment-only bodies
  if arg._raw_content
    node._raw_content = arg._raw_content
  node

-- parse source string and return internal AST
-- returns: ast_node or nil, error_message
parse = (src) ->
  raw_ast, err = yue.to_ast src, 0
  unless raw_ast
    return nil, err

  build raw_ast

-- predicate helpers
is = {}
is.a = views.is_a
-- check if node is a function/method call
is.chainvalue_call = (node) ->
  unless views.is_a node, types.ChainValue
    return false

  last = node.items[#node.items]
  (views.is_a last, types.Invoke, types.InvokeArgs) and true or false

export default {
  :build
  :parse
  :is

  -- ast/views.yue
  unwrap: views.unwrap
  binary: views.binary
  ident: views.ident
  literal: views.literal
  scalar: views.scalar
  call: views.call

  -- ast/assign.yue
  extract: assign.extract
  simplify: assign.simplify
}
