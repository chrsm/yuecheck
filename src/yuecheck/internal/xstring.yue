stripq = (str) -> str\gsub "[\"']", ''

stripnl = (str) ->
  -- don't do match, greedy+slow
  while #str > 0 and str\sub(-1) == '\n'
    str = str\sub 1, -2
  str

match_any = (str, pats) ->
  for p in *pats
    if str\match p
      return p

-- count newlines in a string to determine line span
count_nl = (str) ->
  n = 0
  for _ in str\gmatch '\n'
    n += 1
  n

export default {
  :stripnl
  :stripq
  :match_any
  :count_nl
}
